# Supabase (read by @env Babel plugin — no EXPO_PUBLIC_ prefix needed)
SUPABASE_URL=https://ctqwxwrcxwruaqojohpf.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Backend URL — use your LAN IP for device testing (e.g. http://192.168.1.x:8002)
EXPO_PUBLIC_BACKEND_URL=http://localhost:8002

# Google Maps (optional — used by area selector map)
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
