# Bricks GO — Frontend (Expo React Native) Environment Variables
#
# Copy to frontend/.env for Expo Go / local metro:
#   cp frontend/.env.example frontend/.env
#
# EXPO_PUBLIC_BACKEND_URL is required for API + capture shutter.
# EAS profiles also inject this via eas.json.

EXPO_PUBLIC_BACKEND_URL=https://dispatch-api.brxs.ca
