{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://dispatch-api.brxs.ca"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://dispatch-api.brxs.ca"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://dispatch-api.brxs.ca"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": true
      }
    },
    "play": {
      "extends": "production",
      "distribution": "store",
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://dispatch-api.brxs.ca"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": true
      }
    }
  }
}
