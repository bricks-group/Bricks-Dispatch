{
  "expo": {
    "owner": "akashorter",
    "name": "Bricks GO",
    "slug": "bricks-go",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bricks-go",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bricks.go"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#141210"
      },
      "package": "com.bricks.go",
      "edgeToEdgeEnabled": true,
      "versionCode": 4
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#141210"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bricks GO uses your location to verify you're on-site when checking in to a job."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "73175818-4388-41fd-82fa-0b2e48a666ed"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/73175818-4388-41fd-82fa-0b2e48a666ed"
    }
  }
}
