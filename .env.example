# =============================================================================
# Bricks GO — Environment Variable Reference
# Grouped by sub-project with descriptions and required/optional annotations.
# =============================================================================
# Copy this file to the appropriate sub-project .env file(s) and fill in
# the values. Each sub-project reads from its own directory's .env file.
#
# Sub-projects:
#   backend/   — Python/FastAPI API server
#   web/       — React/Vite dashboard (Dashboard UI)
#   frontend/  — Expo React Native (Photographer mobile app)
# =============================================================================


# ---------------------------------------------------------------------------
# BACKEND — Python / FastAPI (backend/.env)
# ---------------------------------------------------------------------------
#
# --- Database (Supabase) ---
SUPABASE_URL=https://your-project.supabase.co
# Required. The Supabase project URL. Used by all database operations.
# Type: string
# Required: yes

SUPABASE_KEY=your-supabase-anon-key
# Optional. Fallback key if SUPABASE_SERVICE_KEY is not set. Used for
# Supabase client initialization.
# Type: string
# Required: no (but SUPABASE_SERVICE_KEY is preferred)

SUPABASE_SERVICE_KEY=your-supabase-service-role-key
# Required. The Supabase service_role key (bypasses RLS). Used for
# server-side database access. Falls back to SUPABASE_KEY if not set.
# Type: string
# Required: yes (or SUPABASE_KEY)

# --- S3-Compatible Storage (Cloudflare R2 / AWS S3) ---
AWS_ACCESS_KEY_ID=your-access-key-id
# Required for file uploads (S3-compatible object storage). If not set,
# storage is disabled (uploads fall back to in-memory thumbnails).
# Type: string
# Required: no (optional; storage disabled if missing)

AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Required for file uploads (S3-compatible object storage). If not set,
# storage is disabled.
# Type: string (secret)
# Required: no (optional; storage disabled if missing)

AWS_S3_BUCKET=brxs-deliverables
# Optional. S3 bucket name for uploaded deliverables.
# Default: "brxs-deliverables"
# Type: string
# Required: no

AWS_S3_REGION=auto
# Optional. AWS region for S3 endpoint. Use "auto" for Cloudflare R2.
# Default: "auto"
# Type: string
# Required: no

AWS_S3_ENDPOINT_URL=https://your-account.r2.cloudflarestorage.com
# Optional. Custom S3-compatible endpoint URL (for Cloudflare R2, MinIO, etc.).
# If empty, uses AWS default endpoint.
# Type: string (URL)
# Required: no

# --- AI Dispatch (Gemini) ---
GEMINI_API_KEY=your-gemini-api-key
# Required for AI-powered smart assignment. Uses Gemini 1.5 Flash via
# litellm to intelligently match jobs to photographers.
# Type: string (secret)
# Required: no (optional; AI dispatch disabled if missing)

USE_AI_DISPATCH=true
# Optional. Toggle AI dispatch on/off. Set to "false" to disable.
# Default: "true"
# Type: "true" | "false"
# Required: no

# --- Server ---
ALLOWED_ORIGINS=*
# Optional. Comma-separated list of allowed CORS origins.
# Default: "*" (all origins allowed)
# Type: string (comma-separated URLs)
# Required: no

# --- Internal Service Auth ---
INTERNAL_API_KEY=dp-<random-32-char-hex>  # Internal auth key. Other services send X-Internal-Api-Key header with this value.
BROKERAGE_API_URL=http://localhost:8003    # Brokerage service base URL
BOOKING_API_URL=http://localhost:8001      # Booking service base URL

# --- Seed Data ---
SEED_ENABLED=false
# Optional. Enable the POST /api/seed endpoint for seeding test data.
# Default: "false" (disabled)
# Type: "true" | "false"
# Required: no

# --- Storage URLs ---
SIGNED_URL_EXPIRY_SECONDS=3600
# Optional. Default expiry time (in seconds) for pre-signed S3 download URLs.
# Default: "3600" (1 hour)
# Type: integer (string)
# Required: no


# ---------------------------------------------------------------------------
# WEB — React / Vite Dashboard (web/.env)
# ---------------------------------------------------------------------------
#
VITE_SUPABASE_URL=https://your-project.supabase.co
# Required. Supabase project URL for auth and real-time subscriptions.
# Must match the backend's SUPABASE_URL.
# Type: string (URL)
# Required: yes

VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Required. Supabase anon/public key (publishable, safe for frontend).
# Used for client-side auth (magic link login, session management).
# Type: string
# Required: yes

VITE_API_BASE_URL=http://localhost:8000
# Required. Backend API base URL. In development, points to your local
# backend (default 8000). In production, point to the deployed API.
# Default: "http://localhost:8000"
# Type: string (URL)
# Required: yes


# ---------------------------------------------------------------------------
# FRONTEND — Expo React Native (Photographer Mobile App) (frontend/.env)
# ---------------------------------------------------------------------------
#
EXPO_PUBLIC_BACKEND_URL=https://bricks-dispatch-production.up.railway.app
# Required. Backend API base URL for the mobile app. Used by all API calls,
# push notification registration, and data fetching.
# Default: "http://localhost:8002"
# Type: string (URL)
# Required: yes

EXPO_PUBLIC_ACTOR_ID=default_user
# Optional. Fallback actor/user ID when no Supabase session is available.
# Used for X-User-Id header in API requests for non-authenticated contexts.
# Default: "default_user"
# Type: string
# Required: no

EXPO_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-api-key
# Optional. Google Maps JavaScript API key, used in the BricksAOSelector
# web component for mapping and area-of-operation selection.
# Type: string (secret)
# Required: no

# --- Metro / Build (not runtime) ---
METRO_CACHE_ROOT=
# Optional. Path to Metro bundler cache root directory. If not set, uses
# default .metro-cache inside the frontend directory.
# Type: string (filesystem path)
# Required: no
