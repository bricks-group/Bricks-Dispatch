# Database
# MONGO_URL=mongodb://localhost:27017
DB_NAME=bricks_shared

# File storage (Supabase Storage — uses existing SUPABASE_URL + SUPABASE_SERVICE_KEY)
SUPABASE_STORAGE_BUCKET=brxs-deliverables
SIGNED_URL_EXPIRY_SECONDS=3600

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
# Fair-Use auth fallback: the project's ES256 PUBLIC JWK (JSON, one line, no "d").
# Optional SUPABASE_JWT_KID if the JWK has no kid. Unset = fallback off.
SUPABASE_JWT_PUBLIC_JWK=

# Sentry
SENTRY_DSN=https://your-dsn@sentry.io/your-project

# Internal service URLs and keys
BOOKING_API_URL=http://localhost:8001
BOOKING_API_KEY=your-booking-api-key
ALLOWED_ORIGINS=*
INTERNAL_API_KEYS=key1,key2
SEED_ENABLED=false
