{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "250mb",
        "maxDuration": 300
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/vendor-os/calendars/sync-cron",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/onboarding/review-backlog",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/onboarding/credential-expiry",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/ops/daily",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/onboarding/probation-sweep",
      "schedule": "0 13 * * *"
    }
  ]
}
